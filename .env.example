# Gnani ASR (https://gnani.ai/speech-to-text-api)
GNANI_API_KEY=

# Google AI Studio (https://aistudio.google.com/apikey) - used for summarization
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Where the sqlite db + uploaded audio files live.
# On Render this should point at the mounted persistent disk.
DATA_DIR=./data

PORT=3000
